{
  "name": "home (devenv)",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  "remoteUser": "root",
  "mounts": [
    "source=home-nix-store,target=/nix,type=volume"
  ],
  "postCreateCommand": "devenv allow && devenv shell -- true",
  "customizations": {
    "vscode": {
      "extensions": [
        "mkhl.direnv",
        "jnoortheen.nix-ide",
        "arrterian.nix-env-selector"
      ]
    }
  }
}